# development | production | test
NODE_ENV=development

PORT=3000

DATABASE_URL=postgresql://user:password@localhost:5432/express_server?schema=public

# fatal | error | warn | info | debug | trace (default: info in production, debug otherwise)
LOG_LEVEL=debug

# Number of proxies in front of the app (0 locally, 1 behind an AWS load balancer)
TRUST_PROXY=0
